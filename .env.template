# ─────────────────────────────────────────────────────────────
# Plux — משתני סביבה
# הקובץ הזה מכיל סודות ואסור שיעלה לגיטהאב. ודא ש-.gitignore מכיל .env*
# ─────────────────────────────────────────────────────────────

# Supabase → Connect → ORM
# מחרוזת ה-pooler (פורט 6543). זו המחרוזת שהאפליקציה משתמשת בה.
DATABASE_URL="הדבק כאן"

# חיבור ישיר (פורט 5432). למיגרציות, ולסקריפטים שרצים כטרנזקציה ארוכה
# אחת (ראו PLUX_DIRECT_DB למטה) — הן לא יכולות לרוץ דרך pooler.
DIRECT_URL="הדבק כאן"

# ─── הרשאה (Clerk — clerk.com) ───────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ─── עוזר ה-AI (Pluxer) והסיכומים החודשיים ───────────────────
# מפתח Anthropic — console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# אופציונלי: דריסת מודל/ספק ברירת המחדל של ה-AI
# PLUX_AI_PROVIDER="anthropic"
# PLUX_CHAT_MODEL="claude-..."
# PLUX_CLASSIFY_MODEL="claude-..."

# ─── Supabase — מפתחות ניהול ──────────────────────────────────
# נדרש רק לכמה פעולות ניהול ספציפיות (לא לגישת ה-DB הרגילה, זו עוברת
# דרך Prisma/DATABASE_URL למעלה).
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."

# ─── טיקר השוק בדף הבית (S&P 500 דרך SPY) — lib/market/index.ts ──
# חינמי, בלי כרטיס אשראי: הרשמה ב-twelvedata.com. בלי המפתח הזה
# הטיקר פשוט לא מופיע (לא שגיאה, לא קריסה) — ראו לוג "[market]"
# בטרמינל של npm run dev אם הוא לא מופיע.
TWELVE_DATA_API_KEY="הדבק כאן"

# ─── אופציונלי: מגן על app/api/cron/* מפני קריאות לא מורשות ──
# Vercel Cron שולח את הסוד הזה ב-Authorization header, ראו vercel.json.
# CRON_SECRET="..."

# ─── אופציונלי: כפתור "היכנס כדמו" ────────────────────────────
# ה-id של משתמש הדמו ב-Clerk (נוצר על ידי scripts/create-demo-user.mts,
# ראו את ההערות שם). בלי המשתנה הזה הכפתור פשוט לא עובד.
# DEMO_USER_ID="user_..."

# נקרא רק על ידי scripts/create-demo-user.mts בזמן יצירת משתמש הדמו —
# לא נקרא בזמן ריצה של האפליקציה עצמה.
# DEMO_EMAIL="plux-demo@example.com"

# ─── אופציונלי: כאשר =1, סקריפטים (כמו scripts/seed-demo.mts) ─
# מתחברים דרך DIRECT_URL במקום DATABASE_URL — עוקף את ה-pooler
# לטרנזקציות ארוכות.
# PLUX_DIRECT_DB=1
